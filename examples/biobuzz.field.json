    { "name": "blue alliance area", "colour": "blue", "width": 1, "points": [[197.15, 24.09], [197.15, 119.91]] },
    { "name": "blue alliance area", "colour": "blue", "width": 1, "points": [[197.15, 119.91], [143.65, 119.91]] },

    // The GARDEN is two parallel strips 2 in apart, and the zone is the strip between them.
    { "name": "red garden", "colour": "red", "width": 1, "points": [[1.9, 2.4], [24.59, 2.4]] },
    { "name": "red garden", "colour": "red", "width": 1, "points": [[1.9, 3.4], [24.59, 3.4]] },
    { "name": "blue garden", "colour": "blue", "width": 1, "points": [[119.41, 140.6], [142.1, 140.6]] },
    { "name": "blue garden", "colour": "blue", "width": 1, "points": [[119.41, 141.6], [142.1, 141.6]] },

    // The LOADING ZONE is three strips; the fourth side is the perimeter wall (9.3).
    { "name": "red loading zone", "colour": "red", "width": 1, "points": [[1.9, 96.41], [12.4, 96.41]] },
    { "name": "red loading zone", "colour": "red", "width": 1, "points": [[12.4, 96.41], [12.4, 118.1]] },
    { "name": "red loading zone", "colour": "red", "width": 1, "points": [[12.4, 118.1], [1.9, 118.1]] },

    { "name": "blue loading zone", "colour": "blue", "width": 1, "points": [[142.1, 25.9], [131.6, 25.9]] },
    { "name": "blue loading zone", "colour": "blue", "width": 1, "points": [[131.6, 25.9], [131.6, 47.59]] },
    { "name": "blue loading zone", "colour": "blue", "width": 1, "points": [[131.6, 47.59], [142.1, 47.59]] }
  ],

  // ---- AprilTags, manual 9.9 ---------------------------------------------------------------------
  //
  // Sixteen 3.25 in 36h11 tags, in four clusters of four, one cluster on the UNDERSIDE of each
  // CELL "facing downward towards the TILES". Nothing in this game is on a wall, which is the
  // single biggest difference from DECODE for anybody porting a vision pipeline: the camera has
  // to look UP.
  //
  // THE IDS COME FROM FIGURE 9-17 AND NOT FROM SECTION 9.9'S TEXT. The manual's prose extracts as
  // "AprilTag ID's 0, , , on the red CELL..." -- its embedded font subset has no mapping for
  // several digits, so they come out as nothing at all rather than as an error. The real IDs are
  // 30-33 and 34-37 on the red CELLS and 38-41 and 42-45 on the blue. See
  // tools/manual-figures.js, which exists because of this.
  //
  // "pitchDeg" is the tag's tilt. These sit 30 degrees off horizontal, face down -- measured off
  // the CAD, where the sticker normals come out as exact trig, (0, +/-0.5, -0.866).
  //
  // POSITIONS ALONG A CLUSTER ARE EXACT; ACROSS IT THEY ARE NOT. Figure 9-15 dimensions the four
  // tags at 2.75 and 6.5 in either side of the cluster centre, which the CAD's 17.000 in sticker
  // corroborates -- four 3.25 in tags with outer centres at 6.5 span 16.25 and fit. But the figure
  // never locates the tag centreline on the 5.25 in sticker and the artwork is not geometry, so
  // the height is the sticker's mid-height and is ASSUMED, within about half an inch.
  //
  // THESE POSES ARE THE START OF THE MATCH ONLY. Every one of these tags is on a body that tips,
  // and when a HIVE tips its four tags move to where the other CELL's are now. A field file cannot
  // say that yet, so a pipeline tested against this file is being told something that stops being
  // true the first time somebody scores.
  "aprilTags": [
    { "id": 30, "family": "36h11", "size": 3.25, "x": 65.76, "y": 83.29, "z": 35.71, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 31, "family": "36h11", "size": 3.25, "x": 62.01, "y": 83.29, "z": 35.71, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 32, "family": "36h11", "size": 3.25, "x": 56.51, "y": 83.29, "z": 35.71, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 33, "family": "36h11", "size": 3.25, "x": 52.76, "y": 83.29, "z": 35.71, "yawDeg": -90, "pitchDeg": -60 },

    { "id": 34, "family": "36h11", "size": 3.25, "x": 52.76, "y": 59.22, "z": 49.61, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 35, "family": "36h11", "size": 3.25, "x": 56.51, "y": 59.22, "z": 49.61, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 36, "family": "36h11", "size": 3.25, "x": 62.01, "y": 59.22, "z": 49.61, "yawDeg": -90, "pitchDeg": -60 },
    { "id": 37, "family": "36h11", "size": 3.25, "x": 65.76, "y": 59.22, "z": 49.61, "yawDeg": -90, "pitchDeg": -60 },

    { "id": 38, "family": "36h11", "size": 3.25, "x": 78.26, "y": 60.71, "z": 35.71, "yawDeg": 90, "pitchDeg": -60 },
    { "id": 39, "family": "36h11", "size": 3.25, "x": 82.01, "y": 60.71, "z": 35.71, "yawDeg": 90, "pitchDeg": -60 },
    { "id": 40, "family": "36h11", "size": 3.25, "x": 87.51, "y": 60.71, "z": 35.71, "yawDeg": 90, "pitchDeg": -60 },
    { "id": 41, "family": "36h11", "size": 3.25, "x": 91.26, "y": 60.71, "z": 35.71, "yawDeg": 90, "pitchDeg": -60 },

    { "id": 42, "family": "36h11", "size": 3.25, "x": 91.26, "y": 84.78, "z": 49.61, "yawDeg": 90, "pitchDeg": -60 },
    { "id": 43, "family": "36h11", "size": 3.25, "x": 87.51, "y": 84.78, "z": 49.61, "yawDeg": 90, "pitchDeg": -60 },
