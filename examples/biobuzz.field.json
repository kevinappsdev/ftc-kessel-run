    { "id": 45, "family": "36h11", "size": 3.25, "x": 78.26, "y": 84.78, "z": 49.61, "yawDeg": 90, "pitchDeg": -60 }
  ],

  // ---- Appearance: the official CAD, drawn instead of boxes -------------------------------------
  //
  // DECORATION ONLY. The structures above stay the collision and the hives stay the physics; these
  // meshes are what the field view DRAWS. They are cut from FIRST's field CAD by
  // tools/cad/field_mesh.py into cad/local/ (git-ignored, because the CAD is not ours to
  // redistribute), so on a machine without them the page draws the boxes, exactly as before.
  //
  //   replaces      the structures a loaded mesh stands in for; the page stops drawing their boxes
  //   hive          the part rocks with that alliance's HIVE, turned about its pivot by the live angle
  //   restAngleDeg  the HIVE angle the CAD shows: red's audience CELL up is state 0 (0 deg), blue's
  //                 far CELL up is state 1 (60 deg), which is how a match starts (10.3.1)
  "appearance": {
    "units": "in",
    "parts": [
      { "mesh": "../cad/local/field-mesh/biobuzz/flower-ring.stl", "colour": "#E4B21B",
        "replaces": ["Red-wall FLOWER", "Far-wall FLOWER", "Audience-wall FLOWER", "Blue-wall FLOWER"] },
      { "mesh": "../cad/local/field-mesh/biobuzz/flower-pipe.stl", "colour": "#E9E8E1" },
      { "mesh": "../cad/local/field-mesh/biobuzz/flower-black.stl", "colour": "#2A2C30" },
      { "mesh": "../cad/local/field-mesh/biobuzz/frame.stl", "colour": "#A9AFB6",
        "replaces": ["Red A-frame leg (far)", "Red A-frame leg (audience)", "Blue A-frame leg (far)",
                     "Blue A-frame leg (audience)", "Red frame foot bar", "Blue frame foot bar", "HIVE crossbar"] },
      { "mesh": "../cad/local/field-mesh/biobuzz/red-hive-skin.stl", "colour": "#C8323B", "opacity": 0.72, "hive": "red", "restAngleDeg": 0 },
      { "mesh": "../cad/local/field-mesh/biobuzz/red-hive-metal.stl", "colour": "#A9AFB6", "hive": "red", "restAngleDeg": 0 },
      { "mesh": "../cad/local/field-mesh/biobuzz/red-hive-black.stl", "colour": "#2A2C30", "hive": "red", "restAngleDeg": 0 },
      { "mesh": "../cad/local/field-mesh/biobuzz/blue-hive-skin.stl", "colour": "#2F6AD1", "opacity": 0.72, "hive": "blue", "restAngleDeg": 60 },
      { "mesh": "../cad/local/field-mesh/biobuzz/blue-hive-metal.stl", "colour": "#A9AFB6", "hive": "blue", "restAngleDeg": 60 },
      { "mesh": "../cad/local/field-mesh/biobuzz/blue-hive-black.stl", "colour": "#2A2C30", "hive": "blue", "restAngleDeg": 60 }
    ]
  }
